{
    "name": "uab/restaurante-rumbo-al-cielo",
    "description": "Sistema institucional de reservas de almuerzos, reorganizado por capas",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Restaurante\\Domain\\": "src/Domain/",
            "Restaurante\\Application\\": "src/Application/",
            "Restaurante\\Adapters\\": "src/Adapters/",
            "Restaurante\\Infrastructure\\": "src/Infrastructure/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Restaurante\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "test:report": "phpunit --configuration phpunit.xml --log-junit reports/phpunit.xml"
    }
}
